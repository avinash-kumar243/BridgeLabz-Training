/* Exercise 1: Simple CRUD Application
Create a console-based Employee Management System with:
• Add employee
• View all employees
• Update employee salary
• Delete employee
• Search employee by name
*/





------------------------------ Employee Management System ---------------------
------------------------------ Database used :- MySql -------------------------


----- Creating Database -----
CREATE DATABASE employeedb;
USE employeedb;


------ Creating Tables ------
CREATE TABLE employees (
	id INT AUTO_INCREMENT PRIMARY KEY,
	name VARCHAR(30),
	salary INT
);



-------------------------------------------------------------------------------
------------------------------ CRUD OPERATIONS --------------------------------
-------------------------------------------------------------------------------


-------------- 1. Add Employee -------------------
INSERT INTO employees (name, salary)
VALUES
("Avinash", 10000),
("Komal", 20000),
("Deepak", 30000),
("Shivam", 40000),
("Krishna", 50000);


--------------- 2. View all Employees ----------------
SELECT * FROM employees;

-- Output --
+----+---------+--------+
| id | name    | salary |
+----+---------+--------+
|  1 | Avinash |  10000 |
|  2 | Komal   |  20000 |
|  3 | Deepak  |  30000 |
|  4 | Shivam  |  40000 |
|  5 | Krishna |  50000 |
+----+---------+--------+


---------------- 3. Update Employee Salary --------------
UPDATE employees
SET salary = 60000
WHERE name = "Shivam";

-- Current Employee Table --
+----+---------+--------+
| id | name    | salary |
+----+---------+--------+
|  1 | Avinash |  10000 |
|  2 | Komal   |  20000 |
|  3 | Deepak  |  30000 |
|  4 | Shivam  |  60000 |
|  5 | Krishna |  50000 |
+----+---------+--------+


------------------ 4. Delete Employee ------------------
DELETE FROM employees
WHERE name = "Deepak";

-- Current Employee Table --
+----+---------+--------+
| id | name    | salary |
+----+---------+--------+
|  1 | Avinash |  10000 |
|  2 | Komal   |  20000 |
|  4 | Shivam  |  60000 |
|  5 | Krishna |  50000 |
+----+---------+--------+


------------------ 5. Search Employee by name ----------------
SELECT * FROM employees
WHERE name = "Krishna";

-- Output --

+----+---------+--------+
| id | name    | salary |
+----+---------+--------+
|  5 | Krishna |  50000 |
+----+---------+--------+

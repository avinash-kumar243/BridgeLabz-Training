--------------- Creating Database -----------------
CREATE DATABASE IF NOT EXISTS hospital;
USE hospital;



/*
1. Patient Management

UC-1.1: Register New Patient
Actor: Receptionist
Flow: Enter patient details (name, DOB, contact, address, blood group). System 
validates uniqueness by phone/email, generates patient ID, inserts record into 
patients table with auto-increment primary key.
*/

--------------- Patient table creation ------------
CREATE TABLE patients (
patient_id INT AUTO_INCREMENT PRIMARY KEY,
name VARCHAR(30) NOT NULL,
dob DATE NOT NULL,
phone VARCHAR(10) NOT NULL  UNIQUE,
email VARCHAR(40) UNIQUE,
address VARCHAR(250),
blood_group VARCHAR(5),
created_date DATETIME DEFAULT CURRENT_TIMESTAMP
);

--------------- Add Patient ------------------------
INSERT INTO patients

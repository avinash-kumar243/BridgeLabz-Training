/*
UC-1.2: Update Patient Information
Actor: Receptionist
Flow: Search patient by ID/phone, display current details, update fields, execute 
SQL UPDATE with WHERE clause on patient ID.
*/


------------- Update Patient -------------
UPDATE patients
SET phone = '1234567890',
	address = 'Delhi'
WHERE patient_id = 5;


SELECT * FROM patients
WHERE patient_id = 5;

+------------+-------------+------------+------------+-----------------+---------+-------------+---------------------+
| patient_id | name        | dob        | phone      | email           | address | blood_group | created_date        |
+------------+-------------+------------+------------+-----------------+---------+-------------+---------------------+
|          5 | Rohit Kumar | 1994-01-18 | 1234567890 | rohit@gmail.com | Delhi   | O-          | 2026-02-09 07:55:46 |
+------------+-------------+------------+------------+-----------------+---------+-------------+---------------------+




/*
UC-1.3: Search Patient Records
Actor: Receptionist/Doctor
Flow: Query patients table using LIKE operator for name search or exact match for 
ID/phone. Display results using ResultSet iteration.
*/


----------------- Searching patient records ------------------
SELECT * FROM patients
WHERE name LIKE '%Pooja%';

+------------+-------------+------------+------------+-----------------+-----------+-------------+---------------------+
